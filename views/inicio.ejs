
<%- include('partials/header') %>

<!-- Presentación principal -->
<section class="page-container">

    <div class="row align-items-center g-5 py-4">

        <div class="col-lg-7">

            <p class="section-eyebrow">
                Soporte tecnológico universitario
            </p>

            <h1 class="display-4 fw-bold section-title mb-3">
                ¡La tecnología también necesita una mano!
            </h1>

            <p class="lead text-secondary mb-4">
                En HelpDesk puedes reportar problemas técnicos
                relacionados con equipos, proyectores, computadores
                y otros recursos tecnológicos de nuestra institución.
            </p>

            <p class="text-secondary mb-4">
                Nuestro objetivo es facilitar la comunicación con el
                departamento de sistemas y ayudar a mantener los
                espacios académicos funcionando correctamente.
            </p>

            <div class="d-flex flex-wrap gap-3">

                <a href="/reportar" class="btn btn-helpdesk">
                    <i class="bi bi-plus-circle me-2"></i>
                    Reportar una falla
                </a>

                <a href="/panel" class="btn btn-outline-primary rounded-3 px-4 py-3 fw-semibold">
                    Consultar tickets
                </a>

            </div>

        </div>

        <div class="col-lg-5">

            <div class="helpdesk-card text-center p-4">

                <div class="display-1 mb-3">
                    🛠️
                </div>

                <h3 class="fw-bold section-title">
                    Estamos para ayudarte
                </h3>

                <p class="text-secondary mb-0">
                    Reporta tu inconveniente de manera rápida
                    y permite que nuestro equipo de soporte
                    pueda atenderlo.
                </p>

            </div>

        </div>

    </div>

    <!-- Cómo funciona el servicio -->
    <section class="mt-5">

        <div class="text-center mb-4">

            <p class="section-eyebrow">
                Nuestro servicio
            </p>

            <h2 class="section-title fw-bold">
                ¿Cómo funciona HelpDesk?
            </h2>

            <p class="text-secondary">
                Tres pasos para gestionar una falla técnica.
            </p>

        </div>

        <div class="row g-4">

            <div class="col-md-4">

                <article class="helpdesk-card h-100 text-center">

                    <div class="display-4 mb-3">📝</div>

                    <h4 class="fw-bold">1. Reporta</h4>

                    <p class="text-secondary mb-0">
                        Registra tu nombre, la ubicación y una
                        descripción del inconveniente técnico.
                    </p>

                </article>

            </div>

            <div class="col-md-4">

                <article class="helpdesk-card h-100 text-center">

                    <div class="display-4 mb-3">💻</div>

                    <h4 class="fw-bold">2. Revisamos</h4>

                    <p class="text-secondary mb-0">
                        El departamento de sistemas consulta
                        los reportes pendientes para atenderlos.
                    </p>

                </article>

            </div>

            <div class="col-md-4">

                <article class="helpdesk-card h-100 text-center">

                    <div class="display-4 mb-3">✅</div>

                    <h4 class="fw-bold">3. Resolvemos</h4>

                    <p class="text-secondary mb-0">
                        Una vez solucionado el inconveniente,
                        el reporte se marca como resuelto.
                    </p>

                </article>

            </div>

        </div>

    </section>

</section>

<%- include('partials/footer') %>
